---
import { linkStyles } from 'ui/base/link/link.styles';

import type { LinkProps as Props } from './link.types';

const { href, variant, external, class: className, ...rest } = Astro.props;

/*
 * The three halves of the external-link contract ship as one unit deliberately.
 * target="_blank" without the rel is a tabnabbing vector, and without the sr-only suffix
 * the change of context goes unannounced. They lived at three separate call sites before
 * S-07 — which is exactly how they drift apart. Do not separate them.
 */
const externalAttributes = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class:list={[linkStyles({ variant }), className]} {...externalAttributes} {...rest}>
  <slot />{external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
