---
import { CV_LABEL, CV_PATH, EMAIL, GITHUB_URL, LINKEDIN_URL, LOCATION } from 'constants/contact.constants';
import { cn } from 'styles/utils';
import { buttonStyles } from 'ui/base/button/button.styles';

import Section from '../layout/Section.astro';

// `h-auto min-h-10` overrides the pinned `h-10` in button.styles.ts, which clips any label
// that wraps (S-07 carried-in work; src/ui/base is F-01-frozen).
const linkStyles = cn(buttonStyles({ variant: 'outline' }), 'h-auto min-h-10 text-center');
---

<Section id="contact">
  <h2 slot="label">Contact</h2>

  <div class="space-y-element">
    <div class="space-y-tight">
      <p>
        <a class="underline underline-offset-4" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>

      <p class="text-text-secondary">{LOCATION} &mdash; remote</p>
    </div>

    <div class="flex flex-wrap gap-element">
      <a class={linkStyles} href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">
        LinkedIn<span class="sr-only"> (opens in a new tab)</span>
      </a>

      <a class={linkStyles} href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        GitHub<span class="sr-only"> (opens in a new tab)</span>
      </a>

      <a class={linkStyles} href={CV_PATH}>{CV_LABEL}</a>
    </div>
  </div>
</Section>
